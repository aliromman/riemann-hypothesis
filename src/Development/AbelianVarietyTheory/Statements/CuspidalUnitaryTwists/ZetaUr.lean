namespace GlobalTheory.Ord2

variable {Ω : Type} [Field Ω] [Algebra ℚ Ω] {l : ℕ} [Fact l.Prime]

def SrcUr (ι : Qbar l ≃+* ℂ) (e : ℕ) (A : ValuationSubring Ω) (W : R2 Ω l) (g : Newform (2 * e + 1)) : Prop :=
  ¬ l ∣ g.M ∧ ‖ι.symm (g.a l)‖ = 1 ∧ ∃ χ : G ℚ Ω →* (Qbar l)ˣ, KillsMu l χ ∧
    g.Att ι (tw W (cycBar ℚ Ω l ^ (-(e : ℤ)) * (dt W)⁻¹ * χ)) ∧
    ∀ s ∈ Ine (F := ℚ) A, mat W s 1 1 * (cycBar ℚ Ω l s : Qbar l) ^ (e : ℤ) * ((dt W s : Qbar l)⁻¹ * (χ s : Qbar l)) = 1

def ZetaUr : Prop :=
  ∀ (l : ℕ) [Fact l.Prime] (Ω : Type) [Field Ω] [Algebra ℚ Ω] [IsAlgClosure ℚ Ω] (ι : Qbar l ≃+* ℂ) (e : ℕ) (S : Finset Pl)
    (A : ValuationSubring Ω) (W : R2 Ω l) (g : Newform (2 * e + 1)), Nf e S A W → SrcUr ι e A W g → ES W A

end GlobalTheory.Ord2


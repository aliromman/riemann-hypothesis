variable {Ω : Type} [Field Ω] [Algebra ℚ Ω] {l : ℕ} [Fact l.Prime]

def FixIc (c : Coef l) (a : Qbar l) : Prop :=
  ∀ σ : Qbar l ≃ₐ[ℚ_[l]] Qbar l, (∀ b ∈ c.O, σ b = b) → (∀ x : Qbar l, ‖x‖ ≤ 1 → ‖σ x - x‖ < 1) → σ a = a


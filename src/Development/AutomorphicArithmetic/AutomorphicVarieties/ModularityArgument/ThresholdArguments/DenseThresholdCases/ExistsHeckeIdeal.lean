    ∃ (lam : Wt L l n) (ρ : V.frame.G₀ →* GL (Fin n) (Qbar l)), Continuous ρ ∧ Formalism.MainNotions.N.IsSSRep ρ ∧ _root_.UpperTheory.V.Hi.CaseU.UnitaryPointProperties r ι lam ρ ∧
      x.IsRep (ρ.comp V.pr) := by
